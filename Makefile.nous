# Nous layer targets.
# Included by consuming repos via: -include Makefile.nous

# Resolve the actual nous directory even when this Makefile is symlinked
# into a consuming repo (e.g., brain/Makefile.nous → ../nous/Makefile.nous).
# `realpath` follows symlinks; `lastword $(MAKEFILE_LIST)` is the path of the
# Makefile currently being processed.
# Compute NOUS_DIR via a shell subprocess rather than make's built-in
# path functions (abspath/realpath/dir). Reason: make's path functions
# operate on whitespace-tokenized values; any path with a space in it
# (notably the tart VM's `/Volumes/My Shared Files/<repo>/` mount point,
# which ~/repo symlinks through) gets fragmented and produces garbage
# like `/Volumes/ ./ Files/...`.
#
# The shell version: cd into the dir-of-Makefile.nous (quoted, handles
# spaces) and emit pwd -L. pwd -L preserves the symlink path the operator
# cd'd through (vs `pwd -P` which resolves) — so inside the VM, NOUS_DIR
# becomes ~/repo/ (no spaces) rather than the underlying mount path. On
# the host (no symlinks involved) it's identical to the previous result.
NOUS_DIR := $(shell cd '$(dir $(lastword $(MAKEFILE_LIST)))' && pwd -L)/

.PHONY: nous-build nous-sign nous-notarize nous-dev nous-install nous-install-notarized nous-uninstall test clean trim identity moveto cloneto new-brain nous-bootstrap nous-test-bootstrap nous-test-snapshot nous-test-roundtrip nous-test-brain-sync

# Where installed binaries land. PATH-stable on most operator
# machines; no sudo; survives Homebrew rebuilds.
NOUS_INSTALL_PREFIX ?= $(HOME)/.local/bin

# Codesign identity for `make nous-sign`. Unset →
# scripts/sign.sh auto-detects a single "Developer ID Application"
# identity from the codesigning keychain. Set to override (cert
# rotation, multi-team operator). No ad-hoc fallback: ad-hoc emits a
# cdhash-only DR that invalidates keychain ACL grants on every rebuild,
# and blocks hardened runtime — degraded posture with no offsetting
# upside.
NOUS_CODESIGN_IDENTITY ?=

# Notarytool keychain profile for `make nous-notarize` /
# `make nous-install-notarized`. Stored once via:
#   xcrun notarytool store-credentials nous-notary \
#       --apple-id <your-apple-id> --team-id <your-team-id> \
#       --password <app-specific-password>
# (or set NOUS_NOTARYTOOL_PROFILE to a different profile name).
NOUS_NOTARYTOOL_PROFILE ?= nous-notary

# Codesigning posture (post nous#16 ACL realization + nous#20
# single-binary + nous#20 side-quest "drop ad-hoc"):
# `make nous-sign` signs the unified `nous` binary with a Developer
# ID Application cert so it identifies as the production `charon`
# keychain namespace + binds ACLs to its cert-anchored Designated
# Requirement. Closes the agent-bypass gap where an agent-written
# script could `security find-generic-password ...` and exfiltrate
# raw OAuth tokens — bypassing the proxy's audit trail.
#
# Two postures only:
#   `make nous-dev`  — unsigned, `charon-dev` keychain namespace,
#                       isolated from production credentials.
#   `make nous-sign` — Developer ID-signed, `charon` namespace,
#                       hardened runtime enabled. Follow with
#                       `nous service install` to register launchd.
# Ad-hoc as a third posture was a transitional artifact (operator
# had no Developer ID); retired in nous#20.
#
# See atlas/nous/dev-vs-runtime-mode.md for the threat-model rationale.
# The security audit + menubar are now `nous security check / menubar`
# subcommands inside the unified binary (nous#22). A separate signed
# .app wrapper for the menubar is a deferred follow-up (rescoped from
# nous#19); without it, notifications fall through to terminal-notifier.

# Three-phase pipeline:
#
#   nous-build      → unsigned go build (fast; charon-dev keychain namespace)
#   nous-sign       → adds Developer ID codesign to bin/nous (charon namespace)
#   nous-notarize   → adds Apple notary submission to bin/nous (Gatekeeper-clear)
#
# Each phase depends on the previous via PHONY prereqs, so chains run
# top-to-bottom on every invocation (no stale-build false-cache risk).
#
# Local install: `make nous-sign && nous service install` (two steps,
#   intentionally — see comment on the install-side block below).
# nous-install-notarized = nous-notarize + install + launchd (for cross-Mac
#   distribution; keeps the combined gesture because notarization is slow).
#
# The `nous-` prefix on every target is deliberate: brain repos (and
# other nous consumers) commonly define their own `make build` for
# per-brain utilities; namespacing keeps them from colliding.
#
# Scope: builds ONLY bin/nous. Other cmd/<name>/* binaries (gmail,
# oneshot, and any user-authored utilities) are built by the shared
# `make build` (defined in Makefile.workflow, vendored from ariadne).
# The split mirrors the user-facing model: `nous-build` is for nous
# contributors rebuilding the nous binary itself; `build` is for
# end users + brain-repo authors building their own skill binaries.
nous-build:
	@mkdir -p bin cmd/nous/bin
	@echo "building cmd/nous/bin/nous"
	@go build -o cmd/nous/bin/nous ./cmd/nous
	@ln -sf ../cmd/nous/bin/nous bin/nous

# nous-sign adds Developer ID codesigning to bin/nous specifically.
# Plugins (bin/gmail, bin/oneshot, …) are deliberately left unsigned —
# they're meant as example utilities a user might build for their own
# brain, not part of the signed nous substrate. Plugins fall into the
# charon-dev keychain namespace at runtime (unsigned ⇒ dev namespace).
#
# Useful by itself when iterating on signing-dependent behavior
# (keychain ACL, codesign-based gates) — avoids the notarytool
# round-trip that nous-install-notarized incurs.
nous-sign: nous-build
	@echo "==> Signing bin/nous (identity=$(NOUS_CODESIGN_IDENTITY))..."
	@NOUS_CODESIGN_IDENTITY=$(NOUS_CODESIGN_IDENTITY) scripts/sign.sh bin/nous

# nous-notarize submits the signed bin/nous to Apple's notary service
# and waits for the verdict. Required only for distribution to other
# Macs (Gatekeeper accepts the binary on first launch without the
# right-click-then-Open ceremony). Local operator install is fine on
# nous-sign alone — Gatekeeper accepts a Developer-ID-signed binary
# from the same Apple ID that signed it without notarization.
#
# Stapling is intentionally not attempted: `xcrun stapler` requires
# an .app/.pkg/.dmg wrapper. Bare Mach-O notarization lives in
# Apple's records; Gatekeeper fetches the verdict online on first
# launch. Stapled .app packaging is tracked as the rescoped nous#19.
#
# Wall-clock: 30s–5min depending on Apple's queue. Don't put this on
# the daily-iteration path.
nous-notarize: nous-sign
	@echo "==> Notarizing bin/nous (profile=$(NOUS_NOTARYTOOL_PROFILE))..."
	@if ! xcrun notarytool history --keychain-profile $(NOUS_NOTARYTOOL_PROFILE) >/dev/null 2>&1; then \
	    echo "  [error] notarytool profile '$(NOUS_NOTARYTOOL_PROFILE)' not found in keychain"; \
	    echo "  one-time setup:"; \
	    echo "    xcrun notarytool store-credentials $(NOUS_NOTARYTOOL_PROFILE) \\"; \
	    echo "      --apple-id <your-apple-id> --team-id <your-team-id> \\"; \
	    echo "      --password <app-specific-password>"; \
	    echo "  (app-specific password: generate at https://appleid.apple.com → Sign-In and Security → App-Specific Passwords)"; \
	    exit 1; \
	fi
	@zip=/tmp/nous-notarize-$$$$.zip; \
	ditto -c -k --keepParent bin/nous $$zip; \
	xcrun notarytool submit $$zip --keychain-profile $(NOUS_NOTARYTOOL_PROFILE) --wait; \
	rm -f $$zip
	@echo "==> Notarized. (Stapling skipped — bare Mach-O; first-launch Gatekeeper check fetches online.)"

# Build every cmd/<name>/ binary unsigned to top-level bin/ for
# development. Stops the launchd-installed production services first
# so port 8230 is free for foreground `bin/nous serve` testing
# (and so the running prod instance doesn't keep doing work while
# you iterate on dev binaries).
#
# Unsigned binaries → charon-dev keychain namespace at runtime
# (lib/provider/vault/keychain/service.go::ResolveServiceName
# inspects code-signing state). Isolated from the production install's
# charon namespace — no chance of dev iteration corrupting prod
# OAuth state.
#
# Layout (post nous#22):
#   bin/nous              unified CLI/TUI + daemon (proxy + brain-sync)
#                         + security audit + menubar (via subcommands)
#   bin/gmail, bin/oneshot, ...
#
# Single daemon binary: `nous serve` runs both the credential proxy
# and brain-sync watcher as goroutines under one process. The previous
# cmd/charon/ and cmd/brain-sync/ binaries were retired in nous#20
# once their CLI verbs moved onto `nous`.
#
# Why `rm -f bin/<name>` before each `go build -o`: macOS code-signing
# state can stick to a binary's prior inode in cached form (Gatekeeper
# / Security framework / sometimes launchd's open-fd). Switching
# between signed (production) and unsigned (dev) versions of the same
# binary at the same path doesn't always invalidate that cache. Result:
# the new unsigned binary inherits the old signed binary's namespace
# resolution, or vice versa, until you explicitly remove + rebuild.
# Cheap insurance: rm first, build second. Verified bug from prior
# iteration; keep the rm.
nous-dev:
	@echo "==> Stopping launchd-installed services (best-effort)..."
	@launchctl bootout gui/$$(id -u) com.42shots.nous 2>/dev/null || true
	@launchctl bootout gui/$$(id -u) com.charon.proxy 2>/dev/null || true
	@launchctl bootout gui/$$(id -u) com.xianxu.brain-sync 2>/dev/null || true
	@launchctl bootout gui/$$(id -u) com.xianxu.nous 2>/dev/null || true
	@echo "==> Building all binaries unsigned to bin/..."
	@mkdir -p bin
	@for dir in cmd/*/; do \
		[ -f "$$dir/main.go" ] || continue; \
		name=$$(basename "$$dir"); \
		echo "  building bin/$$name"; \
		rm -f "bin/$$name"; \
		go build -o "bin/$$name" "./$$dir"; \
	done
	@echo ""
	@echo "==> Running ./bin/nous serve in foreground (charon-dev namespace, unsigned)"
	@echo "    Ctrl-C exits both daemons gracefully."
	@echo "    For signed production install: make nous-sign && nous service install"
	@echo ""
	@exec ./bin/nous serve $(NOUS_DEV_ARGS)

# The local-install path is now two steps: `make nous-sign` to
# produce a Developer-ID-signed binary at nous/bin/nous, then
# `nous service install` to register + kickstart launchd. These
# are kept separate so the operator can re-sign (after a code
# change) without disturbing an already-running service, and
# re-install the service (e.g., to pick up a plist change) without
# re-signing. The old "copy to install prefix + register launchd"
# gesture (formerly bundled under `nous-install`) was unbundled
# once the install prefix collapsed to nous/bin: the copy step
# became redundant, and the only remaining work was `nous service
# install`, which is already a public command.
#
# The name `nous-install` was reclaimed for a different gesture
# below: put nous on the operator's PATH (rc-append to $NOUS_DIR/bin).
# Mirrors ariadne's sdlc-install. Distinct from install-nous-and-
# launchd (the service-side install, still a private helper used by
# nous-install-notarized).
#
# nous-install-notarized stays because the notary roundtrip + the
# distribution-grade install belong together as a single gesture
# operators only run when actually shipping to another Mac.

# nous-install: put $(NOUS_DIR)bin on the operator's PATH (zsh/bash
# rc-append, idempotent). Standalone re-entry point for the rc-append
# logic that scripts/nous-bootstrap.sh also invokes on fresh-Mac
# bootstrap. Requires bin/nous to already exist — runs `make nous-
# build` first if you need a fresh build.
nous-install:
	@"$(NOUS_DIR)scripts/nous-install.sh"

# nous-install-notarized: full distribution-grade install. Same flow
# as the local sign+install path but the binary has been through
# Apple's notary before it lands at $(NOUS_INSTALL_PREFIX). 30s-to-
# minutes slower due to the notary roundtrip.
nous-install-notarized: nous-notarize install-nous-and-launchd
	@echo ""
	@echo "==> Done (signed + notarized). Verify with: nous service status"

# install-nous-and-launchd: the install-side common work for
# nous-install-notarized (which still wants the combined gesture
# because notarization is slow). Not a public target — the
# dependency chain (nous-notarize) guarantees the signed-and-
# notarized binary is at nous/bin/nous.
#
# Operates on nous/bin/nous in place — the old separate $(NOUS_
# INSTALL_PREFIX) copy was retired with `make nous-install`.
.PHONY: install-nous-and-launchd
install-nous-and-launchd:
	@echo "==> Stopping dev foreground process (best-effort)..."
	@pkill -f '$(NOUS_DIR)bin/nous serve' 2>/dev/null || true
	@pkill -f 'bin/nous serve' 2>/dev/null || true
	@echo "==> Registering + starting com.42shots.nous launchd service..."
	@$(NOUS_DIR)bin/nous service install
	@echo ""
	@echo "  [note] this is a namespace flip: production credentials"
	@echo "         live in keychain service=\"charon\" (was charon-dev"
	@echo "         when running unsigned via make nous-dev). Any OAuth"
	@echo "         tokens previously stored under charon-dev are NOT"
	@echo "         visible to the signed binary; re-auth as needed."
	@echo "         For signed .app packaging of nous security menubar,"
	@echo "         see the rescoped nous#19 (deferred follow-up to nous#22)."

# make nous-uninstall — stops and removes the unified launchd
# service plus any legacy plists left over from earlier milestones.
# Idempotent; safe on a machine that never installed. Doesn't
# remove the binary at nous/bin/nous — the operator may still want
# to invoke nous directly.
nous-uninstall:
	@echo "==> Stopping dev foreground process (best-effort)..."
	@pkill -f '$(NOUS_DIR)bin/nous serve' 2>/dev/null || true
	@pkill -f 'bin/nous serve' 2>/dev/null || true
	@echo "==> Removing launchd service(s)..."
	@if [ -x $(NOUS_DIR)bin/nous ]; then \
		$(NOUS_DIR)bin/nous service uninstall; \
	else \
		echo "  no nous binary at $(NOUS_DIR)bin/nous; falling back to direct launchctl"; \
		launchctl bootout gui/$$(id -u) com.42shots.nous 2>/dev/null || true; \
		launchctl bootout gui/$$(id -u) com.charon.proxy 2>/dev/null || true; \
		launchctl bootout gui/$$(id -u) com.xianxu.brain-sync 2>/dev/null || true; \
		launchctl bootout gui/$$(id -u) com.xianxu.nous 2>/dev/null || true; \
		rm -f ~/Library/LaunchAgents/com.42shots.nous.plist; \
		rm -f ~/Library/LaunchAgents/com.charon.proxy.plist; \
		rm -f ~/Library/LaunchAgents/com.xianxu.brain-sync.plist; \
		rm -f ~/Library/LaunchAgents/com.xianxu.nous.plist; \
	fi
	@echo ""
	@echo "==> Done."

test:
	go test ./...

# Bootstrap the nous developer toolchain on a fresh Mac. Installs Xcode CLT
# (if needed), Homebrew (if needed), packages from Brewfile, GPG identity (via
# scripts/identity.sh), openshell + gh auth (via .openshell/Makefile), and the
# fzf shell hook. Idempotent — re-running on a complete machine is a no-op.
#
# Usage:
#   make bootstrap            (canonical, end-user-facing)
#   make nous-bootstrap       (backward-compat alias; pre-rename muscle memory)
#
# Renamed from `nous-bootstrap` → `bootstrap` because end users shouldn't
# need to know about the `nous-*` namespace — that's for binary
# development verbs (nous-build, nous-install, nous-sign, etc.). The
# alias stays as a soft-deprecation; will go away once the rename has
# had a few months to settle into operator docs + muscle memory.
#
# Spec: workshop/issues/000011-nous-bootstrap.md.
bootstrap nous-bootstrap:
	@"$(NOUS_DIR)scripts/nous-bootstrap.sh"

# Run nous-bootstrap end-to-end inside a disposable tart VM, with a gcrypt
# round-trip verification using a throwaway GPG fixture from
# testdata/test-bootstrap/. Always recreates the VM from `tahoe-base`; always
# tears down on exit.
#
# Usage:
#   make nous-test-bootstrap
#
# Prereqs (host): tart installed, `tahoe-base` image present locally, sshpass
# auto-installed via Homebrew on first run.
#
# Spec: workshop/issues/000011-nous-bootstrap.md M2.
nous-test-bootstrap:
	@"$(NOUS_DIR)scripts/nous-test-bootstrap.sh"

# Build the `tahoe-bootstrapped` tart VM — a stopped clone of `tahoe-base`
# with `nous-bootstrap.sh` already applied. `make nous-test-roundtrip` clones
# this snapshot for a fast (~25s) iteration test that skips the ~125s
# Brewfile install. Run when `Brewfile` or `scripts/nous-bootstrap.sh` changes.
#
# Usage:
#   make nous-test-snapshot
#
# Spec: workshop/issues/000011-nous-bootstrap.md M3.
nous-test-snapshot:
	@"$(NOUS_DIR)scripts/nous-test-snapshot.sh"

# Fast gcrypt round-trip test using the `tahoe-bootstrapped` snapshot. ~25s.
# Skips the bootstrap layer — only validates GPG import + encrypt/decrypt
# round-trip. Use during round-trip / pinentry / gcrypt iteration. Use
# `make nous-test-bootstrap` when you've changed Brewfile or nous-bootstrap.sh.
#
# Usage:
#   make nous-test-roundtrip
#
# Prereqs: `make nous-test-snapshot` (one-time, refresh on Brewfile change).
#
# Spec: workshop/issues/000011-nous-bootstrap.md M3.
nous-test-roundtrip:
	@"$(NOUS_DIR)scripts/nous-test-roundtrip.sh"

# Local two-process integration test for brain-sync. Sets up a bare + two
# clones in $TMPDIR, starts two brain-sync watchers, exercises propagation
# and conflict resolution. ~15s end-to-end. No VM required.
#
# Usage:
#   make nous-test-brain-sync
#
# Spec: workshop/plans/000004-shared-brain-sync-daemon-plan.md chunk 7.
nous-test-brain-sync:
	@"$(NOUS_DIR)scripts/test-brain-sync.sh"

# Bootstrap GPG identity for brain encryption. Idempotent: re-running detects
# an existing key and skips generation. Configures gpg-agent + pinentry-mac so
# the GPG passphrase is fetched from macOS login Keychain.
#
# Usage:
#   make identity                                  # uses git config user.name/email
#   IDENTITY_NAME='Your Name' IDENTITY_EMAIL='you@example.com' make identity
#
# Spec: nous#3 M1 Step 0; threat model brain/atlas/threat-model-shared-brain.md.
identity:
	@"$(NOUS_DIR)scripts/identity.sh"

# Clone the current repo to a new location with full git history. Generic
# primitive: just clones, strips the auto-created origin, prints next steps.
# Refuses to overwrite an existing target.
#
# Usage:
#   make moveto TARGET=../some-other-path
moveto:
	@[ -n "$(TARGET)" ] || { echo "Usage: make moveto TARGET=<target-path>" >&2; exit 1; }
	@"$(NOUS_DIR)scripts/moveto.sh" "$(TARGET)"

# Clone the current git repo to a new location AS a gcrypt-encrypted brain.
# Interactive end-to-end: prompts for target path, creates or confirms-overwrite
# of the GitHub target repo, prompts to select a GPG identity (if multiple),
# configures the gcrypt remote, authors .brain/config.md, force-pushes.
#
# Usage:
#   make cloneto
#
# Prereqs: `make identity` (a usable GPG keypair); `gh auth login`.
# Spec: nous#3 M1 step 3.
cloneto:
	@"$(NOUS_DIR)scripts/cloneto.sh"

# Bootstrap a brand-new gcrypt-encrypted brain at a target path. Unlike
# `cloneto` (which mirrors the current repo's full git history), new-brain
# provisions an empty brain — fresh git init, no source history. Interactive:
# prompts for path (if not given), GitHub owner+name, GPG identity. Creates
# the GitHub repo (private), runs ../nous/construct/setup.sh --yes in the new tree,
# authors .brain/config.md, commits, pushes.
#
# Usage:
#   make new-brain                  # interactive (prompts for target path)
#   make new-brain ../brain         # positional path (see catch-all below)
#
# Prereqs: `make identity` (a usable GPG keypair); `gh auth login`.
new-brain:
	@"$(NOUS_DIR)scripts/new-brain.sh" $(filter-out $@,$(MAKECMDGOALS))

# Allow positional args after `make new-brain` (e.g. `make new-brain ../brain`)
# without make complaining "no rule to make target ../brain". Scoped: this
# catch-all is only defined when `new-brain` is among the requested goals,
# so it doesn't silently swallow typos in normal `make` invocations.
ifneq ($(filter new-brain,$(MAKECMDGOALS)),)
%:
	@:
endif

clean:
	@for dir in cmd/*/; do \
		rm -rf "$$dir/bin"; \
	done

# Trim git history — keep only the last DAYS days of commits.
# Usage: make trim DAYS=90
DAYS ?= 90

trim:
	@ROOT=$$(git rev-list --max-parents=0 HEAD); \
	CUTOFF=$$(git rev-list --after="$(DAYS) days ago" --reverse HEAD | head -1); \
	if [ -z "$$CUTOFF" ]; then \
		echo "All commits are within the last $(DAYS) days. Nothing to trim."; \
		exit 0; \
	fi; \
	if [ "$$CUTOFF" = "$$ROOT" ]; then \
		echo "Oldest commit is already the boundary. Nothing to trim."; \
		exit 0; \
	fi; \
	BEFORE=$$(git rev-list --count $$CUTOFF..HEAD); \
	TOTAL=$$(git rev-list --count HEAD); \
	DROPPING=$$((TOTAL - BEFORE)); \
	echo "Keeping $$BEFORE commits (last $(DAYS) days)"; \
	echo "Squashing $$DROPPING older commits into a single root"; \
	echo "Boundary: $$(git log -1 --format='%h %ci %s' $$CUTOFF)"; \
	echo ""; \
	read -p "Continue? [y/N] " confirm; \
	if [ "$$confirm" != "y" ] && [ "$$confirm" != "Y" ]; then \
		echo "Aborted."; \
		exit 0; \
	fi; \
	git replace --graft $$CUTOFF && \
	FILTER_BRANCH_SQUELCH_WARNING=1 git filter-branch -- --all && \
	rm -rf .git/refs/replace/ && \
	git reflog expire --expire=now --all && \
	git gc --prune=now && \
	echo "" && \
	echo "Done. Run 'git push --force' to update remote."
