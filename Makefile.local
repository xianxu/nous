# Nous repo-specific targets.

# `make refresh` invokes construct/setup.sh (vendored from ariadne),
# which auto-discovers ancestors via go.mod replace directives. No
# UPSTREAM_NAME / UPSTREAM_REFRESH overrides needed — those legacy
# variables were removed from Makefile.workflow in ariadne post-#32.

# Include nous layer targets (build, test, clean, trim)
-include Makefile.nous

# Tart VM targets (tart, tart-gui, tart-mount, tart-stop, tart-clean)
# live in .tart/Makefile, vendored from ariadne and auto-included by
# Makefile.workflow. `make help-tart` for usage.
